# PostgreSQL
POSTGRES_DB=snapserve
POSTGRES_USER=snapserve
POSTGRES_PASSWORD=

# Backend database connection when running outside Docker
DATABASE_URL=jdbc:postgresql://localhost:5432/snapserve
DATABASE_USERNAME=snapserve
DATABASE_PASSWORD=

# JWT — generate a value with: openssl rand -base64 64
# Must be at least 64 bytes for HS512.
JWT_SECRET=

# Frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# API port
SERVER_PORT=8080
