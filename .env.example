# MongoDB Atlas
MONGODB_URI=

# JWT — must be ≥ 64 characters (512 bits) for HS512
JWT_SECRET=

# Gmail SMTP (notification-service)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=

# Docker Compose Settings
RESTART_POLICY=no                    # Options: no, always, unless-stopped
APP_ENV=local                        # Use production with docker compose -f docker-compose.prod.yml up --build
SPRING_PROFILES_ACTIVE=

# Gateway rate limiting
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_USE_FORWARDED_FOR=false
GATEWAY_RATE_LIMIT_REQUESTS_PER_WINDOW=120
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# MongoDB (if using local container instead of Atlas)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password

# Service URLs (use Docker Compose service names in compose, localhost:PORT locally)
AUTH_SERVICE_URL=
USER_SERVICE_URL=
BOOKING_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
