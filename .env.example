# MongoDB Atlas
MONGODB_URI=

# JWT — must be ≥ 64 characters (512 bits) for HS512
JWT_SECRET=

# Gmail SMTP (notification-service)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=

# Service URLs (use Docker Compose service names in compose, localhost:PORT locally)
AUTH_SERVICE_URL=
USER_SERVICE_URL=
BOOKING_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
