# ====================
# Java / Gradle
# ====================
# Build outputs
build/
.gradle/
*.class
*.jar
out/
target/
HELP.md

# Maven wrapper (keep jar, ignore everything else)
!.mvn/wrapper/maven-wrapper.jar

# Keep target directories in src (for resources)
!**/src/main/**/target/
!**/src/test/**/target/

# Keep build directories in src (for resources)
!**/src/main/**/build/
!**/src/test/**/build/

